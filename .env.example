# Copy to .env and adjust. `npm run setup` writes this file for you if missing.
#
# LOCAL — matches the role and database that `npm run setup` creates.
DATABASE_URL=postgres://app:app@localhost:5432/mos

# HOSTED — use the POOLED connection string your provider gives you.
#   Neon      ...-pooler.<region>.aws.neon.tech/...
#   Supabase  port 6543, not 5432
# The client detects a pooled endpoint from the URL and disables prepared
# statements, which a transaction-mode pooler cannot hold across a hand-off.
# DATABASE_URL=postgres://user:password@host-pooler.region.aws.neon.tech/mos?sslmode=require
